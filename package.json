{
  "name": "animal-range-finder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsx scripts/build-seo.ts",
    "preview": "vite preview",
    "data": "tsx scripts/build-data.ts && tsx scripts/build-introduced.ts && tsx scripts/build-sounds.ts && tsx scripts/build-near.ts",
    "time": "tsx scripts/build-time.ts",
    "sounds": "tsx scripts/build-sounds.ts",
    "introduced": "tsx scripts/build-introduced.ts",
    "audit": "tsx scripts/audit-status.ts",
    "assets": "tsx scripts/fetch-assets.ts && tsx scripts/fetch-states.ts",
    "states": "tsx scripts/fetch-states.ts",
    "check": "tsx scripts/check-data.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "fuse.js": "^7.5.0",
    "globe.gl": "^2.46.2",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "mapshaper": "^0.7.80",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  }
}
